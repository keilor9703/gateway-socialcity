<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config para hospedar el gateway en IIS (Windows Server) mediante el
  ASP.NET Core Module V2 (in-process). Requiere instalar el "ASP.NET Core 8 Hosting Bundle"
  en el servidor. 'dotnet publish' genera/actualiza este archivo automáticamente.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\GatewaySocialCity.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
